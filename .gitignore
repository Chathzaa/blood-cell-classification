*.tar.gz
*.tar.bz2

# Keep ONLY trained weights - ignore everything else in runs/
runs/**
!runs/
!runs/detect/
!runs/detect/runs/
!runs/detect/runs/stage1_detection/
!runs/detect/runs/stage1_detection/weights/
!runs/detect/runs/stage1_detection/weights/best.pt
!runs/detect/runs/stage2_classification/
!runs/detect/runs/stage2_classification/weights/
!runs/detect/runs/stage2_classification/weights/best.pt
!runs/detect/runs/stage3_final/
!runs/detect/runs/stage3_final/weights/
!runs/detect/runs/stage3_final/weights/best.pt

